# FlashSeat environment template — PRODUCTION-STYLE values.
# Copy to .env and fill in every <PLACEHOLDER>. Never commit a real .env.
# The local .env used for development/tests loosens some limits (notably
# RATE_LIMIT_REGISTER_IP_LIMIT=400); a fresh deploy must start from THIS file.

NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=<GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARS>
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7
HOLD_DURATION_SECONDS=600
MAX_SEATS_PER_RESERVATION=6
MAX_SEATS_PER_BULK_CALL=2000
MAX_SEATS_PER_VENUE=20000
# Must be false in production (enforced by src/config/env.ts).
ENABLE_MOCK_PAYMENT=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=1000
DB_IDLE_IN_TX_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=10000
SWEEPER_INTERVAL_MS=15000
SWEEPER_BATCH_SIZE=200
SWEEPER_MAX_RUN_MS=10000
DB_APPLICATION_NAME=flashseat-api
REDIS_URL=redis://<REDIS_HOST>:6379
ENABLE_RATE_LIMITING=true
RATE_LIMIT_LOGIN_IP_LIMIT=10
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_EMAIL_LIMIT=5
RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=60
# Real policy: 30 registrations per IP per 60s.
RATE_LIMIT_REGISTER_IP_LIMIT=30
RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=60
RATE_LIMIT_RESERVATION_USER_LIMIT=20
RATE_LIMIT_RESERVATION_USER_WINDOW_SECONDS=60
MAX_INFLIGHT_BOOKING_REQUESTS=150
INFLIGHT_SAFETY_TTL_SECONDS=10
ENABLE_SEAT_MAP_CACHE=true
SEAT_MAP_CACHE_TTL_MS=2000
