{
  "name": "flashseat",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:concurrency": "vitest run tests/concurrency.test.ts",
    "migrate:create": "node-pg-migrate -m migrations --migration-file-language sql create",
    "migrate:up": "node-pg-migrate -m migrations --migration-file-language sql up",
    "migrate:down": "node-pg-migrate -m migrations --migration-file-language sql down",
    "db:verify-002": "docker compose exec -T postgres psql -U flashseat -d flashseat -f - < scripts/verify-002.sql",
    "db:backfill-seats": "docker compose exec -T postgres psql -U flashseat -d flashseat -f - < scripts/backfill-show-seats.sql",
    "db:check-invariants": "docker compose exec -T postgres psql -U flashseat -d flashseat -f - < scripts/check-invariants.sql",
    "db:check-sweeper-invariants": "docker compose exec -T postgres psql -U flashseat -d flashseat -f - < scripts/check-sweeper-invariants.sql",
    "db:show-settings": "tsx scripts/show-db-settings.ts",
    "smoke:concurrency": "node scripts/smoke-concurrency.mjs",
    "smoke:checkout": "node scripts/smoke-checkout.mjs",
    "sweeper": "tsx src/workers/sweeper.ts",
    "sweeper:once": "tsx src/workers/sweeper-once.ts",
    "verify:sweeper": "node scripts/verify-sweeper.mjs",
    "load:seed:contention": "node load/seed.mjs --name contention --shows 1 --seats 100",
    "load:seed:throughput": "node load/seed.mjs --name throughput --shows 200 --seats 50",
    "load:register:contention": "node load/register-users.mjs --name contention --count 1200",
    "load:register:throughput": "node load/register-users.mjs --name throughput --count 10000",
    "load:contention": "node load/run.mjs contention",
    "load:throughput": "node load/run.mjs throughput",
    "load:timeline": "node load/timeline.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
