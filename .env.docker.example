# Env for the LOCAL docker compose stack (api, sweeper, migrate).
# Copy to .env.docker (gitignored) and fill in the <PLACEHOLDER>s:
#   cp .env.docker.example .env.docker
#
# This is a local dev/test stack, not a production template (that's .env.example):
# it mirrors the host .env so the test battery (npm run test:docker) can run
# against the containers. Values the tests depend on are marked below.
#
# DATABASE_URL and REDIS_URL are NOT set here: docker-compose.yml sets them with
# the container hostnames (postgres, redis), which differ from the host .env's
# localhost URLs.

# development, not production: env.ts refuses ENABLE_MOCK_PAYMENT=true in
# production, and the test suite + smoke-checkout.mjs need mock payment.
NODE_ENV=development
PORT=3000
# Tests sign their own JWTs with the host .env's secret: to run the tests against
# this stack, use the SAME value as JWT_ACCESS_SECRET in your .env.
# Otherwise generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=<SAME_AS_YOUR_.ENV_OR_A_RANDOM_32+_CHAR_SECRET>
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7
HOLD_DURATION_SECONDS=600
MAX_SEATS_PER_RESERVATION=6
MAX_SEATS_PER_BULK_CALL=2000
MAX_SEATS_PER_VENUE=20000
ENABLE_MOCK_PAYMENT=true
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=1000
DB_IDLE_IN_TX_TIMEOUT_MS=10000
# Keep below the api/sweeper stop_grace_period (15s) in docker-compose.yml.
SHUTDOWN_TIMEOUT_MS=10000
SWEEPER_INTERVAL_MS=15000
SWEEPER_BATCH_SIZE=200
SWEEPER_MAX_RUN_MS=10000
# The sweeper container overrides this to flashseat-sweeper itself (src/workers/set-app-name.ts).
DB_APPLICATION_NAME=flashseat-api
ENABLE_RATE_LIMITING=true
RATE_LIMIT_LOGIN_IP_LIMIT=10
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_EMAIL_LIMIT=5
RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=60
# LOCAL DEV/TEST VALUE ONLY (production policy: 30/60s, see .env.example). The
# integration suite registers ~300 users from one IP within a single window.
RATE_LIMIT_REGISTER_IP_LIMIT=400
RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=60
RATE_LIMIT_RESERVATION_USER_LIMIT=20
RATE_LIMIT_RESERVATION_USER_WINDOW_SECONDS=60
MAX_INFLIGHT_BOOKING_REQUESTS=150
INFLIGHT_SAFETY_TTL_SECONDS=10
ENABLE_SEAT_MAP_CACHE=true
SEAT_MAP_CACHE_TTL_MS=2000
