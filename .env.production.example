# FlashSeat production env for docker-compose.prod.yml (runbook: docs/deploy-aws.md).
#
#   cp .env.production.example .env.production   # on the SERVER, never committed
#   chmod 600 .env.production
#
# Fill in every <PLACEHOLDER>. Every service in docker-compose.prod.yml reads this
# file. Use plain letters/digits for secrets (the hex commands below): a $ in a value
# would be treated as a variable by compose, and @ : / would break DATABASE_URL.
# Generate a secret with:   openssl rand -hex 32

# ---------------------------------------------------------------- site
# The public host name Caddy serves and gets a certificate for. Default option: the
# server's public IP with dashes + .sslip.io (13.233.10.20 -> 13-233-10-20.sslip.io).
# With your own domain: the domain name (its DNS A record must point at the server).
SITE_DOMAIN=<PUBLIC-IP-WITH-DASHES>.sslip.io

# ---------------------------------------------------------------- core
NODE_ENV=production
PORT=3000
JWT_ACCESS_SECRET=<GENERATE_WITH_openssl_rand_-hex_32>
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7
# Caddy serves the API under /api (prefix stripped), so the browser sees the auth
# routes at /api/auth: the refresh cookie must use that path. (Default /auth is for dev.)
REFRESH_COOKIE_PATH=/api/auth
# The API is reachable only through Caddy (one proxy hop): trust exactly one hop so
# rate limits see the client's IP from X-Forwarded-For, not Caddy's.
TRUST_PROXY=1
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------- database (compose postgres)
# The postgres container creates this user/database on its FIRST start (empty volume).
# Changing them later does not change the existing database.
POSTGRES_USER=flashseat
POSTGRES_PASSWORD=<GENERATE_WITH_openssl_rand_-hex_24>
POSTGRES_DB=flashseat
# Must repeat the three values above. Host "postgres" is the compose service name.
DATABASE_URL=postgres://flashseat:<SAME_AS_POSTGRES_PASSWORD>@postgres:5432/flashseat
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=1000
DB_IDLE_IN_TX_TIMEOUT_MS=10000
# The sweeper overrides this to flashseat-sweeper itself.
DB_APPLICATION_NAME=flashseat-api

# ---------------------------------------------------------------- redis (compose redis, no password: not published)
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------- booking
HOLD_DURATION_SECONDS=600
MAX_SEATS_PER_RESERVATION=6
MAX_SEATS_PER_BULK_CALL=2000
MAX_SEATS_PER_VENUE=20000
SWEEPER_INTERVAL_MS=15000
SWEEPER_BATCH_SIZE=200
SWEEPER_MAX_RUN_MS=10000

# ---------------------------------------------------------------- payments
# Mock payment is refused when NODE_ENV=production (src/config/env.ts).
ENABLE_MOCK_PAYMENT=false
PAYMENT_PROVIDER=razorpay
# Razorpay dashboard (Test Mode for a demo) -> Account & Settings -> API Keys.
# The key id is public (sent to the browser); the key secret is not.
RAZORPAY_KEY_ID=<rzp_test_YOUR_KEY_ID>
RAZORPAY_KEY_SECRET=<RAZORPAY_KEY_SECRET>
# The secret you type when creating the webhook (URL: https://<SITE_DOMAIN>/api/webhooks/razorpay).
RAZORPAY_WEBHOOK_SECRET=<GENERATE_WITH_openssl_rand_-hex_32>
PAYMENT_JOBS_BATCH_SIZE=20
REFUND_MAX_ATTEMPTS=5

# ---------------------------------------------------------------- rate limits (production policy)
ENABLE_RATE_LIMITING=true
RATE_LIMIT_LOGIN_IP_LIMIT=10
RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_EMAIL_LIMIT=5
RATE_LIMIT_LOGIN_EMAIL_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_IP_LIMIT=30
RATE_LIMIT_REGISTER_IP_WINDOW_SECONDS=60
RATE_LIMIT_RESERVATION_USER_LIMIT=20
RATE_LIMIT_RESERVATION_USER_WINDOW_SECONDS=60
MAX_INFLIGHT_BOOKING_REQUESTS=150
INFLIGHT_SAFETY_TTL_SECONDS=10
ENABLE_SEAT_MAP_CACHE=true
SEAT_MAP_CACHE_TTL_MS=2000

# ---------------------------------------------------------------- demo catalog (optional)
# Only read by `docker compose -f docker-compose.prod.yml run --rm seed-catalog`
# (scripts/seed-catalog.mjs): the password of the demo organizer accounts it creates.
# At least 8 characters. Leave the placeholder if you do not seed.
DEMO_PASSWORD=<GENERATE_WITH_openssl_rand_-hex_12>
